# WinForge .gitignore

# Build output
dist/
out/

# PowerShell
*.psrc

# IDE
.vscode/
.idea/
*.suo
*.user

# OS
Thumbs.db
Desktop.ini
.DS_Store
._*

# Logs
*.log

# Temporary files
*.tmp
*.bak
*.swp
~$*

# Local environment
.env
.env.local

# Benchmarks & snapshots (user-generated)
Benchmarks/
Snapshots/

# Dependencies (vendored, don't ignore)
# !src/profiles/Vendor/

# Test results
TestResults/
*.trx

# Build artifacts
*.nupkg
*.zip
