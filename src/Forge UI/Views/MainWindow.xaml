<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinForge v1.0.0 — The Windows Forge"
        Width="1100" Height="780"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E2E" Foreground="White"
        FontFamily="Segoe UI"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Width" Value="220"/>
            <Setter Property="Height" Value="70"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="16,8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatusBarStyle" TargetType="StatusBar">
            <Setter Property="Background" Value="#181825"/>
            <Setter Property="Foreground" Value="#78909C"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <Border Grid.Row="0" Background="#181825" Padding="20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚒" FontSize="28" Foreground="#2196F3" Margin="0,0,12,0"/>
                    <TextBlock Text="WinForge" FontSize="26" FontWeight="Bold" Foreground="#2196F3"/>
                    <TextBlock Text="v1.0.0" FontSize="14" Foreground="#78909C"
                               VerticalAlignment="Bottom" Margin="10,0,0,4"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="📸 Snapshot" Style="{StaticResource ActionButton}"
                            Width="120" Height="36" Background="#795548" FontSize="12" Margin="4"/>
                    <Button Content="ℹ System Info" Style="{StaticResource ActionButton}"
                            Width="120" Height="36" Background="#37474F" FontSize="12" Margin="4"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="20">
            <StackPanel>
                <!-- Optimization Actions -->
                <TextBlock Text="Optimization" FontSize="16" FontWeight="SemiBold"
                           Foreground="#78909C" Margin="8,8,0,12"/>
                <WrapPanel>
                    <Button Content="🗑  Remove Bloatware" Style="{StaticResource ActionButton}"
                            Background="#FF9800"/>
                    <Button Content="🔒  Privacy Hardening" Style="{StaticResource ActionButton}"
                            Background="#9C27B0"/>
                    <Button Content="⚡  Performance" Style="{StaticResource ActionButton}"
                            Background="#00BCD4"/>
                    <Button Content="🎮  Gaming Mode" Style="{StaticResource ActionButton}"
                            Background="#E91E63"/>
                </WrapPanel>

                <!-- System Tools -->
                <TextBlock Text="System Tools" FontSize="16" FontWeight="SemiBold"
                           Foreground="#78909C" Margin="8,24,0,12"/>
                <WrapPanel>
                    <Button Content="🌐  Network &amp; DNS" Style="{StaticResource ActionButton}"
                            Background="#3F51B5"/>
                    <Button Content="🤖  AI Nuke" Style="{StaticResource ActionButton}"
                            Background="#F44336"/>
                    <Button Content="🔧  Repair System" Style="{StaticResource ActionButton}"
                            Background="#607D8B"/>
                    <Button Content="🛡  Security" Style="{StaticResource ActionButton}"
                            Background="#4CAF50"/>
                </WrapPanel>

                <!-- Maintenance -->
                <TextBlock Text="Maintenance" FontSize="16" FontWeight="SemiBold"
                           Foreground="#78909C" Margin="8,24,0,12"/>
                <WrapPanel>
                    <Button Content="📦  Install Software" Style="{StaticResource ActionButton}"
                            Background="#00897B"/>
                    <Button Content="🔄  Update Drivers" Style="{StaticResource ActionButton}"
                            Background="#5C6BC0"/>
                    <Button Content="🧹  Maintenance" Style="{StaticResource ActionButton}"
                            Background="#8D6E63"/>
                    <Button Content="📋  Apply Profile" Style="{StaticResource ActionButton}"
                            Background="#2196F3"/>
                </WrapPanel>

                <!-- Extras -->
                <TextBlock Text="Extras" FontSize="16" FontWeight="SemiBold"
                           Foreground="#78909C" Margin="8,24,0,12"/>
                <WrapPanel>
                    <Button Content="🚫  Defender Remover" Style="{StaticResource ActionButton}"
                            Background="#D32F2F"/>
                    <Button Content="🔑  Activate Windows" Style="{StaticResource ActionButton}"
                            Background="#FF5722"/>
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Status Bar -->
        <StatusBar Grid.Row="2" Style="{StaticResource StatusBarStyle}">
            <StatusBarItem>
                <TextBlock Text="WinForge v1.0.0 — The Windows Forge" Foreground="#78909C"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="Standard Edition" Foreground="#546E7A"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
